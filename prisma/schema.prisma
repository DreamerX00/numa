// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ================================
// USER & AUTHENTICATION MODELS
// ================================

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  firebaseUid   String?  @unique  // Made optional for NextAuth migration
  email         String   @unique
  emailVerified DateTime?  // Changed to DateTime for NextAuth compatibility
  name          String?    // Added for NextAuth
  image         String?    // Added for NextAuth
  role          UserRole @default(CUSTOMER)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Profile relationship
  profile   UserProfile?
  
  // E-commerce relationships
  orders    Order[]
  cart      CartItem[]
  wishlist  WishlistItem[]
  reviews   Review[]
  addresses Address[]
  
  // Admin relationships
  adminLogs AdminLog[]
  supportTickets SupportTicket[]
  assignedTickets SupportTicket[] @relation("AssignedTickets")
  supportResponses SupportTicketResponse[] @relation("SupportResponses")

  // NextAuth relationships
  accounts      Account[]
  sessions      Session[]

  @@map("users")
}

// NextAuth.js Models
model Account {
  id                String  @id @default(auto()) @map("_id") @db.ObjectId
  userId            String  @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.String
  access_token      String? @db.String
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.String
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model UserProfile {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  userId            String    @unique @db.ObjectId
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Personal Information
  firstName         String?
  lastName          String?
  displayName       String?
  avatar            String?
  phone             String?
  dateOfBirth       DateTime?
  gender            Gender?
  
  // Preferences
  language          String    @default("en")
  currency          String    @default("USD")
  timezone          String    @default("UTC")
  
  // Marketing preferences
  emailMarketing    Boolean   @default(false)
  smsMarketing      Boolean   @default(false)
  pushNotifications Boolean   @default(true)
  
  // Account status
  isActive          Boolean   @default(true)
  lastLoginAt       DateTime?
  
  // Loyalty program
  loyaltyPoints     Int       @default(0)
  loyaltyTier       LoyaltyTier @default(BRONZE)
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("user_profiles")
}

model Address {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  userId      String      @db.ObjectId
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  type        AddressType @default(SHIPPING)
  isDefault   Boolean     @default(false)
  isActive    Boolean     @default(true)
  
  // Address details
  firstName   String
  lastName    String
  company     String?
  address1    String
  address2    String?
  city        String
  state       String
  postalCode  String
  country     String      @default("IN")
  phone       String?
  
  // Usage tracking
  orders      Order[]     @relation("ShippingAddress")
  billingOrders Order[]   @relation("BillingAddress")
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("addresses")
}

// ================================
// PRODUCT CATALOG MODELS
// ================================

model Category {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  parentId    String?   @db.ObjectId
  parent      Category? @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children    Category[] @relation("CategoryHierarchy")
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Status
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(0)
  
  // Relationships
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("categories")
}

model Brand {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String    @unique
  slug        String    @unique
  description String?
  logo        String?
  website     String?
  
  // Status
  isActive    Boolean   @default(true)
  
  // Relationships
  products    Product[]
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("brands")
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  slug        String   @unique
  description String?
  shortDescription String?
  subtitle    String?
  
  // Pricing
  price       Float
  comparePrice Float?
  costPrice   Float?
  
  // Inventory
  sku         String?  @unique
  barcode     String?
  trackQuantity Boolean @default(true)
  quantity    Int      @default(0)
  minQuantity Int      @default(0)
  
  // Physical properties
  weight      Float?
  dimensions  ProductDimensions?
  
  // Shipping configuration
  shippingWeight      Float?
  shippingLength      Float?
  shippingWidth       Float?
  shippingHeight      Float?
  shippingClass       String    @default("standard")
  requiresSpecialHandling Boolean @default(false)
  domesticOnly        Boolean   @default(false)
  individualShippingRate Float?
  fragile             Boolean   @default(false)
  requiresSignature   Boolean   @default(false)
  
  // Media
  images      String[]
  videos      String[]
  
  // SEO
  metaTitle       String?
  metaDescription String?
  
  // Categorization
  categoryId  String   @db.ObjectId
  category    Category @relation(fields: [categoryId], references: [id])
  brandId     String?  @db.ObjectId
  brand       Brand?   @relation(fields: [brandId], references: [id])
  tags        String[]
  
  // Product attributes for jewelry/fashion
  badges      String[]  @default([])
  materials   String[]  @default([])
  gemstones   String[]  @default([])
  
  // Product status
  status      ProductStatus @default(DRAFT)
  isActive    Boolean       @default(true)
  isFeatured  Boolean       @default(false)
  
  // Variants
  hasVariants Boolean       @default(false)
  variants    ProductVariant[]
  
  // Reviews and ratings
  reviews     Review[]
  averageRating Float?
  reviewCount   Int           @default(0)
  
  // E-commerce relationships
  orderItems  OrderItem[]
  cartItems   CartItem[]
  wishlistItems WishlistItem[]
  inventoryLogs InventoryLog[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("products")
}

// Inventory tracking model
model InventoryLog {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  productId String      @db.ObjectId
  product   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Change details
  type      InventoryChangeType
  quantity  Int         // Positive for additions, negative for deductions
  reason    String
  
  // Reference
  orderId   String?     @db.ObjectId
  
  // Metadata
  performedBy String?   // User ID who made the change
  notes       String?
  
  createdAt DateTime    @default(now())

  @@map("inventory_logs")
}

model ProductVariant {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  productId String  @db.ObjectId
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  // Variant details
  name      String
  sku       String? @unique
  price     Float?
  comparePrice Float?
  
  // Inventory
  quantity  Int     @default(0)
  
  // Attributes (size, color, etc.)
  attributes Json
  
  // Media
  image     String?
  images    String[] @default([])
  
  // Status
  isActive  Boolean @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("product_variants")
}

// ================================
// ORDER & CART MODELS
// ================================

model CartItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?  @db.ObjectId
  
  quantity   Int
  price      Float    // Price at time of adding to cart
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@map("cart_items")
}

model Order {
  id             String      @id @default(auto()) @map("_id") @db.ObjectId
  orderNumber    String      @unique
  userId         String      @db.ObjectId
  user           User        @relation(fields: [userId], references: [id])
  
  // Order status
  status         OrderStatus @default(PENDING)
  paymentStatus  PaymentStatus @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  
  // Pricing
  subtotal       Float
  taxAmount      Float       @default(0)
  shippingAmount Float       @default(0)
  discountAmount Float       @default(0)
  totalAmount    Float
  
  // Currency
  currency       String      @default("INR")
  
  // Addresses
  shippingAddressId String?  @db.ObjectId
  shippingAddress   Address? @relation("ShippingAddress", fields: [shippingAddressId], references: [id])
  billingAddressId  String?  @db.ObjectId
  billingAddress    Address? @relation("BillingAddress", fields: [billingAddressId], references: [id])
  
  // Items
  items          OrderItem[]
  shippingLogs   ShippingLog[]
  invoices       Invoice[]
  returns        Return[]
  notes          OrderNote[]
  
  // Payment - PhonePe integration
  phonePeTransactionId         String?
  phonePeMerchantTransactionId String?
  phonePeResponseCode          String?
  paymentIntentId              String?
  paymentMethod                String?
  
  // Shipping
  shippingMethod  String?
  trackingNumber  String?
  carrier         String?
  estimatedDelivery DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  
  // Timestamps
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@map("orders")
}

model OrderItem {
  id         String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String  @db.ObjectId
  order      Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId  String  @db.ObjectId
  product    Product @relation(fields: [productId], references: [id])
  variantId  String? @db.ObjectId
  
  // Product details at time of order
  name       String
  sku        String?
  price      Float
  quantity   Int
  
  // Product snapshot (in case product is deleted)
  productSnapshot Json
  
  createdAt  DateTime @default(now())

  @@map("order_items")
}

model ShippingLog {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String   @db.ObjectId
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Shipping details
  status            String
  trackingNumber    String?
  carrier           String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  
  // Log details
  notes             String?
  updatedBy         String   // Admin email who made the update
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("shipping_logs")
}

model Invoice {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String        @db.ObjectId
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Invoice details
  invoiceNumber  String        @unique
  invoiceDate    DateTime      @default(now())
  dueDate        DateTime?     
  
  // Amounts (frozen at time of invoice generation)
  subtotal       Float
  taxAmount      Float         @default(0)
  shippingAmount Float         @default(0)
  discountAmount Float         @default(0)
  totalAmount    Float
  currency       String        @default("INR")
  
  // GST Details (India specific)
  gstNumber      String?
  cgst           Float         @default(0)
  sgst           Float         @default(0)
  igst           Float         @default(0)
  gstRate        Float         @default(0.18) // Store GST rate used
  
  // Customer information (frozen at time of invoice)
  customerName   String
  customerEmail  String
  customerPhone  String?
  
  // Billing address (frozen at time of invoice)
  billingAddress Json          // Complete address object
  
  // Shipping address (frozen at time of invoice)
  shippingAddress Json?        // Complete address object
  
  // Invoice items (frozen at time of invoice)
  invoiceItems   Json          // Array of invoice line items
  
  // Company details (frozen at time of invoice)
  companyInfo    Json          // Company details used in invoice
  
  // Status
  status         InvoiceStatus @default(DRAFT)
  
  // File storage
  pdfUrl         String?
  htmlContent    String?
  
  // Metadata
  notes          String?
  generatedBy    String?       // Admin who generated
  
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@map("invoices")
}

model Return {
  id             String       @id @default(auto()) @map("_id") @db.ObjectId
  orderId        String       @db.ObjectId
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Return details
  returnNumber   String       @unique
  reason         String
  reasonCategory ReturnReason @default(OTHER)
  
  // Items being returned (JSON array of {itemId, quantity, reason})
  returnItems    Json
  
  // Amounts
  refundAmount   Float        @default(0)
  shippingRefund Float        @default(0)
  restockingFee  Float        @default(0)
  
  // Status
  status         ReturnStatus @default(REQUESTED)
  
  // Shipping details for return
  returnTrackingNumber String?
  returnCarrier        String?
  
  // Admin notes
  adminNotes     String?
  customerNotes  String?
  
  // Dates
  requestedAt    DateTime     @default(now())
  approvedAt     DateTime?
  receivedAt     DateTime?
  processedAt    DateTime?
  completedAt    DateTime?
  
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@map("returns")
}

model OrderNote {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Note details
  note       String
  isInternal Boolean  @default(true)  // If false, visible to customer
  
  // Author
  authorId   String?  @db.ObjectId
  authorName String   // Admin name or "System"
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("order_notes")
}

// ================================
// WISHLIST & REVIEWS
// ================================

model Wishlist {
  id        String         @id @default(auto()) @map("_id") @db.ObjectId
  userId    String         @db.ObjectId
  name      String         @default("My Wishlist")
  isDefault Boolean        @default(true)
  isPublic  Boolean        @default(false)
  items     WishlistItem[]
  
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlistId String?  @db.ObjectId
  wishlist   Wishlist? @relation(fields: [wishlistId], references: [id], onDelete: SetNull)
  
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String   @db.ObjectId
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  rating     Int      // 1-5 stars
  title      String?
  content    String?
  images     String[]
  
  // Verification
  isVerifiedPurchase Boolean @default(false)
  
  // Moderation
  isApproved Boolean  @default(false)
  
  // Helpful votes
  helpfulCount Int    @default(0)
  
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([userId, productId])
  @@map("reviews")
}

// ================================
// ENUMS
// ================================

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum UserRole {
  CUSTOMER
  ADMIN
  SUPER_ADMIN
  SUPPORT
}

enum LoyaltyTier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
  DIAMOND
}

enum AddressType {
  SHIPPING
  BILLING
}

enum InventoryChangeType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  DAMAGED
  RESTOCK
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum AdminLogAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  BULK_UPDATE
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
  CANCELLED
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  RECEIVED
  PROCESSED
  COMPLETED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  SIZE_ISSUE
  NOT_AS_DESCRIBED
  DAMAGED_IN_SHIPPING
  NO_LONGER_NEEDED
  BETTER_PRICE_FOUND
  OTHER
}

// ================================
// EMBEDDED TYPES
// ================================

type ProductDimensions {
  length Float?
  width  Float?
  height Float?
  unit   String @default("cm")
}

// ================================
// ADMIN & SUPPORT MODELS
// ================================

model AdminLog {
  id          String         @id @default(auto()) @map("_id") @db.ObjectId
  userId      String         @db.ObjectId
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  action      AdminLogAction
  resource    String         // e.g., "product", "order", "user"
  resourceId  String?        // ID of the affected resource
  details     Json?          // Additional details about the action
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime       @default(now())

  @@map("admin_logs")
}

model SupportTicket {
  id          String                @id @default(auto()) @map("_id") @db.ObjectId
  ticketNumber String               @unique
  userId      String                @db.ObjectId
  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject     String
  description String
  status      SupportTicketStatus   @default(OPEN)
  priority    SupportTicketPriority @default(MEDIUM)
  
  // Assignment
  assignedToId String?              @db.ObjectId
  assignedTo   User?                @relation("AssignedTickets", fields: [assignedToId], references: [id])
  
  // Metadata
  tags        String[]
  attachments String[]
  
  // Timestamps
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  
  // Responses
  responses   SupportTicketResponse[]

  @@map("support_tickets")
}

model SupportTicketResponse {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  ticketId    String        @db.ObjectId
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  
  userId      String        @db.ObjectId
  user        User          @relation("SupportResponses", fields: [userId], references: [id])
  
  message     String
  attachments String[]
  isInternal  Boolean       @default(false) // Internal notes vs customer-facing
  
  createdAt   DateTime      @default(now())

  @@map("support_ticket_responses")
}

model Banner {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String?
  image       String
  link        String?
  position    String   @default("homepage") // homepage, category, product
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("banners")
}

model SystemSetting {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  key         String   @unique
  value       Json
  description String?
  category    String   @default("general")
  isPublic    Boolean  @default(false) // Whether setting can be accessed by frontend
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

// ================================
// CAROUSEL MODELS
// ================================

model CarouselSlide {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  subtitle    String?
  description String?
  image       String   // Image URL or path
  ctaText     String?  // Call-to-action button text
  ctaLink     String?  // Call-to-action link
  overlay     String?  // CSS class for overlay (e.g., "bg-gradient-to-r from-black/70 to-black/20")
  order       Int      @default(0) // Display order
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("carousel_slides")
}
